# Local development and Vercel production.
# Create a database first, then set this to its MySQL connection string.
MYSQL_URL=mysql://username:password@localhost:3306/ltwgm2026

# Optional CA certificate for verifying a TLS-enabled MySQL provider.
MYSQL_SSL_CA=

# Generate a bcrypt hash for this value; do not commit the plain password.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
